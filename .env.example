# Never commit .env. Export these through your host or trusted shell.
# The application intentionally does not auto-execute or load .env files.
APP_ENV=production
PREVIEW=0
COOKIE_SECURE=1
STORE_CONFIG_PATH=profiles/default.json
STORE_ID=client-unique-id
SITE_URL=https://your-store.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SCHEMA=growthly_private
SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
CLOUDINARY_CLOUD_NAME=CLIENT_OWN_CLOUD
CLOUDINARY_API_KEY=SET_PRIVATELY
CLOUDINARY_API_SECRET=SET_PRIVATELY
# Optional alternative to Cloudinary: a separate client Supabase project/bucket.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SET_PRIVATELY
# SUPABASE_STORAGE_BUCKET=product-images
# Paystack is disabled until the store flag and this server-only key are configured.
# PAYSTACK_SECRET_KEY=SET_PRIVATELY
# DATA_DIR=/persistent/client-specific/path  # local development only on Vercel
